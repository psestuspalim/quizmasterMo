{
  "name": "FeatureUsage",
  "type": "object",
  "properties": {
    "feature_name": {
      "type": "string",
      "description": "Nombre de la funcionalidad"
    },
    "feature_category": {
      "type": "string",
      "description": "Categor\u00eda: admin, student, quiz, course, etc"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario"
    },
    "user_role": {
      "type": "string",
      "description": "Rol del usuario"
    },
    "session_duration": {
      "type": "number",
      "description": "Duraci\u00f3n de la sesi\u00f3n en segundos"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "view",
        "create",
        "edit",
        "delete",
        "export"
      ],
      "description": "Tipo de acci\u00f3n realizada"
    }
  },
  "required": [
    "feature_name",
    "user_email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}